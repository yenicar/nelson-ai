# Copy this file to `.env` and fill in your secrets.
# `.env` is gitignored.

# --- Gemini (Nelson's brain) ---
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram (Nelson's second surface) ---
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Comma-separated Telegram user IDs allowed to chat with Nelson. Leave empty to allow everyone.
TELEGRAM_ALLOWED_USER_IDS=

# --- App ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:3000

# --- Auth (developer login for v1; real auth post-class) ---
DEV_LOGIN_EMAIL=demo@nelson.ai
DEV_LOGIN_PASSWORD=demo
SESSION_SECRET=change-me-to-a-random-string

# --- Data ---
DUCKDB_PATH=./backend/nelson.duckdb
CUSTOMER_DATA_DIR=./data/customer_2000

# --- Default tenant (multi-tenant from day one; demo runs with one) ---
DEFAULT_TENANT_ID=demo-tenant
DEFAULT_TENANT_NAME=Acme Manufacturing

# --- Gmail (optional — for actually SENDING approved emails) ---
# 1. Enable 2-step verification on your Google account
# 2. Generate an app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16-char password below (with or without spaces, both work)
# Leave both blank to use Nelson in draft-only mode (no real sending).
GMAIL_FROM=
GMAIL_APP_PASSWORD=
